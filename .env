# Configuration Variables

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/mydatabase
MONGO_DB=mydatabase

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=1h

# API Keys
API_KEY=your_api_key_here
ANOTHER_API_KEY=your_another_api_key_here

# Bitcoin Wallet Addresses
# Set your own Bitcoin addresses below (bech32 bc1q... or legacy 1.../3... format).
# See .env.example for details.
WALLET_BRAIINS=your_bitcoin_address_here
WALLET_VIABTC=your_bitcoin_address_here
WALLET_F2POOL=your_bitcoin_address_here
WALLET_BINANCE=your_bitcoin_address_here
WALLET_LUXOR=your_bitcoin_address_here
WALLET_MARA=your_bitcoin_address_here